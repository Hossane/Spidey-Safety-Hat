{
  "device_id": "hat-01",

  "audio": {
    "threshold": 0.3,
    "hop_seconds": 0.5,
    "alert_groups": ["ALARM", "SIREN", "HORN", "VOICE", "IMPACT", "FIRE"]
  },

  "video": {
    "camera_unit": 5,
    "fps": 5,
    "threshold": 0.5,
    "alert_groups": ["PERSON", "VEHICLE", "SHARP"],
    "tracking": {
      "enabled": true,
      "groups": ["PERSON", "VEHICLE"],
      "memory_s": 120,
      "reid_min": 0.6,
      "close_area": 0.35,
      "approach_ratio": 1.8,
      "stand_aspect": 1.3,
      "down_aspect": 0.9
    }
  },

  "alerts": {
    "cooldown_seconds": 3.0,
    "combine_window_seconds": 2.0,
    "severity": {
      "COMBINED": "high", "ALARM": "high", "SIREN": "high", "IMPACT": "high", "FIRE": "high",
      "PERSON_DOWN": "high",
      "HORN": "medium", "VOICE": "medium", "VEHICLE": "medium", "SHARP": "medium",
      "PERSON_CLOSE": "medium", "PERSON": "low"
    }
  },

  "gpio": {
    "enabled": true,
    "pin_bcm": 18,
    "buzzer": "active",
    "tone_hz": 2700
  },

  "event_log": "~/hatdetect/events.jsonl"
}
