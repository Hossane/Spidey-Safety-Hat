{
  "device_id": "hat-01",

  "audio": {
    "threshold": 0.3,
    "hop_seconds": 0.5,
    "alert_groups": ["ALARM", "SIREN", "HORN", "VOICE", "IMPACT", "FIRE"]
  },

  "video": {
    "camera_unit": 5,
    "fps": 5,
    "threshold": 0.5,
    "alert_groups": ["PERSON", "VEHICLE", "SHARP"]
  },

  "alerts": {
    "severity": {
      "ALARM": "high", "SIREN": "high", "IMPACT": "high", "FIRE": "high",
      "HORN": "medium", "VOICE": "medium", "VEHICLE": "medium", "SHARP": "medium",
      "PERSON": "low"
    }
  },

  "fusion": {
    "confirm_wait_seconds": 1.0,
    "episode_gap_seconds": 3.0,
    "escalate_on_confirmation": true,
    "realert_on_escalation": true,
    "rules": [
      {"hazard": "VEHICLE_HAZARD", "audio": ["HORN", "SIREN"], "video": ["VEHICLE"],
       "window_seconds": 3.0, "severity": "high"},
      {"hazard": "WORKER_DISTRESS", "audio": ["VOICE", "IMPACT"], "video": ["PERSON"],
       "window_seconds": 3.0, "severity": "high"}
    ]
  },

  "gpio": {
    "enabled": true,
    "pin_bcm": 18,
    "buzzer": "active",
    "tone_hz": 2700
  },

  "event_log": "~/hatdetect/events.jsonl",
  "detection_log": "~/hatdetect/detections.jsonl"
}
